# Copy to .env for local overrides; `npm run dev` loads it. Every variable is optional, so
# uncomment only the ones you want to override.
# NODE_ENV defaults to production; `npm run dev` sets development (readable logs).
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# DATA_FILE=assets/facilities.json
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
# Comma-separated list of allowed browser origins; empty disables CORS.
# CORS_ORIGINS=
# Comma-separated addresses or CIDR ranges of your load balancers, e.g. 10.0.0.0/8. Rate limits
# then use the client address they add to X-Forwarded-For. Empty ignores X-Forwarded-For.
# TRUST_PROXY=
